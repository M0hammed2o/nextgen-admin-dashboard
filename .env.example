# NextGen Admin Suite - Environment Variables
VITE_API_BASE_URL=https://admin-api.nextgenintelligence.co.za
# Deep-link target for "view business" style links into the Manager Dashboard.
# Local dev note: the Manager Dashboard's dev-server port isn't fixed (it
# falls back to the next free port if 8081 is already in use on your
# machine — see the root repo's KNOWN_BUGS.md BUG-0025/TODO.md) — if that
# happens, links built from this value will point at the wrong port locally.
VITE_DASH_URL=https://app.nextgenintelligence.co.za
